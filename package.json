{
  "name": "panier-temoin",
  "private": true,
  "version": "0.4.0",
  "description": "Suivi participatif des prix de supermarché à partir de tickets de caisse. Projet indépendant, sans lien avec Migros.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "ocr": "node scripts/copier-ocr.mjs",
